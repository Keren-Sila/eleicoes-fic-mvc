<%- include('partials/header', { titulo: 'Candidatos' }) %>
<%
  const mapaFotos = { 10: '/img/ana-costa.jpg', 20: '/img/bruno-lima.jpg', 30: '/img/carla-souza.jpg' };
%>

<div class="layout-simulador">
  <!-- COLUNA ESQUERDA: GABINETE REALISTA DA URNA ELETRÔNICA -->
  <section class="urna-hardware-wrapper">
    <div class="urna-gabinete-real">
      <!-- Topo Chanfrado do Gabinete Físico -->
      <div class="urna-chanfro-superior">
        <span>JUSTIÇA ELEITORAL • TERMINAL DE VOTAÇÃO UE-2026</span>
        <span class="urna-led-indicador"><i class="ponto-led"></i> TERMINAL ATIVO</span>
      </div>

      <div class="urna-corpo-bipartido">
        <!-- LADO ESQUERDO DO CHASSI: TELA LCD REBAIXADA -->
        <div class="urna-setor-visor">
          <div class="urna-cavidade-visor">
            <div class="urna-moldura-interna">
              <div class="visor-lcd" id="urnaTela">
                <!-- Estado 1: Tela Oficial de Votação -->
                <div class="lcd-votacao" id="lcdConteudoVoto">
                  <div class="lcd-area-meio">
                    <div class="lcd-col-esquerda">
                      <div class="lcd-seu-voto">SEU VOTO PARA</div>
                      <div class="lcd-cargo">Deputado Federal</div>

                      <div class="lcd-linha-numero">
                        <span class="lcd-label-num">Número:</span>
                        <div class="lcd-caixas-digitos" id="caixasNumero">
                          <span class="lcd-digito ativo" id="digito0"></span>
                          <span class="lcd-digito" id="digito1"></span>
                        </div>
                      </div>

                      <div class="lcd-campos-info">
                        <div class="lcd-linha-campo">
                          <span class="lcd-label">Nome:</span>
                          <strong class="lcd-valor" id="telaNome"></strong>
                        </div>
                        <div class="lcd-linha-campo">
                          <span class="lcd-label">Partido:</span>
                          <strong class="lcd-valor" id="telaPartido"></strong>
                        </div>
                        <div class="lcd-status-msg" id="telaStatus"></div>
                      </div>
                    </div>

                    <!-- Quadro 3:4 Oficial do Candidato -->
                    <div class="lcd-col-foto">
                      <div class="lcd-moldura-foto" id="telaAvatarBox">
                        <svg id="telaSilhuetaSvg" viewBox="0 0 120 150" class="lcd-silhueta-default" aria-hidden="true">
                          <circle cx="60" cy="52" r="22" fill="#8c939e"/>
                          <path d="M18 148 C18 102, 102 102, 102 148 Z" fill="#8c939e"/>
                        </svg>
                        <img id="telaFotoImg" class="lcd-foto-real" src="" alt="Foto do candidato" style="display: none;">
                      </div>
                      <span class="lcd-legenda-cargo" id="telaAvatarTag">Deputado Federal</span>
                    </div>
                  </div>

                  <div class="lcd-rodape">
                    <div>Aperte a tecla:</div>
                    <div><strong>VERDE</strong> para CONFIRMAR este voto</div>
                    <div><strong>LARANJA</strong> para REINICIAR este voto</div>
                  </div>
                </div>

                <!-- Estado 2: Tela Clássica de FIM -->
                <div class="lcd-tela-fim" id="lcdConteudoFim" style="display: none;">
                  <div class="fim-progresso-box">
                    <span>GRAVANDO</span>
                    <div class="fim-barra-trilho">
                      <div class="fim-barra-cheia" id="fimBarra"></div>
                    </div>
                  </div>
                  <div class="fim-titulo">FIM</div>
                  <div class="fim-canto">VOTOU</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Baixo-relevo na base do visor -->
          <div class="urna-gravacao-base">
            <span>REPÚBLICA FEDERATIVA DO BRASIL • JUSTIÇA ELEITORAL</span>
          </div>
        </div>

        <!-- LADO DIREITO DO CHASSI: PLACA OFICIAL + TECLADO MECÂNICO TÁTIL -->
        <div class="urna-setor-teclado">
          <!-- Placa Frontal com Brasão da República em Relevo Monocromático -->
          <div class="urna-placa-frontal">
            <svg viewBox="0 0 64 64" width="38" height="38" class="brasao-oficial-svg" aria-hidden="true">
              <circle cx="32" cy="32" r="28" fill="none" stroke="#2c302e" stroke-width="1.8" stroke-dasharray="3 2"/>
              <polygon points="32,6 39,23 57,23 42,33 48,50 32,40 16,50 22,33 7,23 25,23" fill="none" stroke="#1f2321" stroke-width="2.2"/>
              <circle cx="32" cy="32" r="10" fill="none" stroke="#1f2321" stroke-width="2"/>
              <path d="M22 31 Q32 27 42 31" fill="none" stroke="#1f2321" stroke-width="1.6"/>
            </svg>
            <div class="placa-frontal-texto">
              <strong>JUSTIÇA</strong>
              <strong>ELEITORAL</strong>
            </div>
          </div>

          <!-- Painel Escuro Rebaixado do Teclado Físico -->
          <div class="urna-berco-teclas">
            <div class="grade-numerica">
              <% [
                { n: 1, b: '⠁' }, { n: 2, b: '⠃' }, { n: 3, b: '⠉' },
                { n: 4, b: '⠙' }, { n: 5, b: '⠑', central: true }, { n: 6, b: '⠋' },
                { n: 7, b: '⠛' }, { n: 8, b: '⠓' }, { n: 9, b: '⠊' }
              ].forEach(item => { %>
                <button type="button" class="tecla-num" data-num="<%= item.n %>" title="Tecla <%= item.n %>">
                  <span class="num-principal"><%= item.n %></span>
                  <% if (item.central) { %>
                    <span class="tecla-5-relevo" title="Marcação tátil central"></span>
                  <% } %>
                  <span class="num-braille"><%= item.b %></span>
                </button>
              <% }) %>
              <div class="slot-vazio"></div>
              <button type="button" class="tecla-num" data-num="0" title="Tecla 0">
                <span class="num-principal">0</span>
                <span class="num-braille">⠚</span>
              </button>
              <div class="slot-vazio"></div>
            </div>

            <!-- Linha Inferior de Teclas de Função (Padrão Oficial da Urna TSE) -->
            <div class="linha-teclas-funcao">
              <button type="button" class="tecla-acao btn-branco" id="btnBranco">BRANCO</button>
              <button type="button" class="tecla-acao btn-corrige" id="btnCorrige">CORRIGE</button>
              <button type="button" class="tecla-acao btn-confirma" id="btnConfirma">CONFIRMA</button>
            </div>
          </div>
        </div>
      </div>

      <form id="formUrnaVoto" action="/votos" method="POST" style="display:none;">
        <input type="hidden" name="candidatoId" id="inputCandidatoId" value="">
      </form>
    </div>
  </section>

  <!-- COLUNA DIREITA: CANDIDATOS REGISTRADOS + COMO USAR AS TECLAS -->
  <aside class="coluna-lateral">
    <section class="card-painel">
      <div class="card-lateral-header">
        <h2>Candidatos registrados</h2>
        <span><%= candidatos.length %> <%= candidatos.length === 1 ? 'cadastrado' : 'cadastrados' %></span>
      </div>

      <% if (candidatos.length === 0) { %>
        <div class="bloco-vazio">Nenhum candidato cadastrado.</div>
      <% } else { %>
        <table class="tabela-candidatos">
          <thead>
            <tr>
              <th>Nº</th>
              <th>NOME</th>
              <th>PARTIDO</th>
              <th class="col-direita">VOTOS</th>
            </tr>
          </thead>
          <tbody>
            <% candidatos.forEach((candidato, idx) => {
              const urlFoto = candidato.foto || mapaFotos[candidato.numero] || '/img/candidato-padrao.svg';
            %>
              <tr class="linha-candidato <%= idx === 0 ? 'ativa' : '' %>" data-numero="<%= candidato.numero %>" onclick="preencherNaUrna('<%= candidato.numero %>')" title="Clique para carregar na Urna">
                <td class="celula-num"><strong><%= candidato.numero %></strong></td>
                <td class="celula-nome">
                  <div class="nome-com-foto">
                    <img src="<%= urlFoto %>" alt="<%= candidato.nome %>" class="avatar-tabela">
                    <span><%= candidato.nome %></span>
                  </div>
                </td>
                <td class="celula-partido"><%= candidato.partido %></td>
                <td class="celula-votos col-direita"><strong><%= candidato.totalVotos || 0 %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section class="card-painel">
      <div class="card-lateral-header">
        <h2>Como usar as teclas</h2>
      </div>
      <div class="lista-instrucoes-teclas">
        <div class="item-instrucao-tecla">
          <span class="quadrado-cor cor-branco"></span>
          <div>
            <strong>BRANCO</strong>
            <p>Preenche rapidamente o primeiro candidato para teste rápido.</p>
          </div>
        </div>
        <div class="item-instrucao-tecla">
          <span class="quadrado-cor cor-corrige"></span>
          <div>
            <strong>CORRIGE</strong>
            <p>Apaga o número digitado e reinicia o voto atual.</p>
          </div>
        </div>
        <div class="item-instrucao-tecla">
          <span class="quadrado-cor cor-confirma"></span>
          <div>
            <strong>CONFIRMA</strong>
            <p>Confirma o voto e registra na apuração oficial.</p>
          </div>
        </div>
      </div>
    </section>
  </aside>
</div>

<script id="dadosCandidatosJson" type="application/json"><%- JSON.stringify(candidatos) %></script>
<script>
  const mapaFotosPadrao = { 10: '/img/ana-costa.jpg', 20: '/img/bruno-lima.jpg', 30: '/img/carla-souza.jpg' };
  const listaCandidatos = JSON.parse(document.getElementById('dadosCandidatosJson').textContent || '[]').map(c => ({
    ...c,
    foto: c.foto || mapaFotosPadrao[c.numero] || '/img/candidato-padrao.svg'
  }));

  let digitosAtuais = '';
  let candidatoSelecionado = null;
  let votando = false;

  const corpoPagina = document.getElementById('corpoPagina');
  const btnVisorBranco = document.getElementById('btnVisorBranco');
  const btnVisorPreto = document.getElementById('btnVisorPreto');

  const caixas = [
    document.getElementById('digito0'),
    document.getElementById('digito1')
  ];
  const telaNome = document.getElementById('telaNome');
  const telaPartido = document.getElementById('telaPartido');
  const telaStatus = document.getElementById('telaStatus');
  const telaAvatarTag = document.getElementById('telaAvatarTag');
  const telaFotoImg = document.getElementById('telaFotoImg');
  const telaSilhuetaSvg = document.getElementById('telaSilhuetaSvg');
  const inputCandidatoId = document.getElementById('inputCandidatoId');
  const formUrnaVoto = document.getElementById('formUrnaVoto');
  const lcdConteudoVoto = document.getElementById('lcdConteudoVoto');
  const lcdConteudoFim = document.getElementById('lcdConteudoFim');
  const fimBarra = document.getElementById('fimBarra');

  window.definirModoVisor = function(modo) {
    if (modo === 'preto') {
      corpoPagina.classList.add('tema-escuro-tse');
      btnVisorPreto.classList.add('ativo');
      btnVisorBranco.classList.remove('ativo');
    } else {
      corpoPagina.classList.remove('tema-escuro-tse');
      btnVisorBranco.classList.add('ativo');
      btnVisorPreto.classList.remove('ativo');
    }
    try { localStorage.setItem('urnaModoVisor', modo); } catch (e) {}
  };

  try {
    const modoSalvo = localStorage.getItem('urnaModoVisor');
    if (modoSalvo === 'preto') window.definirModoVisor('preto');
  } catch (e) {}

  function tocarBipTecla(frequencia = 920, duracao = 0.055) {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = frequencia;
      gain.gain.value = 0.08;
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duracao);
    } catch (e) {}
  }

  function tocarPirililimUrna() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const sequencia = [
        { f: 1975.5, inicio: 0.00, dur: 0.075 },
        { f: 2093.0, inicio: 0.075, dur: 0.075 },
        { f: 1975.5, inicio: 0.15, dur: 0.075 },
        { f: 2093.0, inicio: 0.225, dur: 0.075 },
        { f: 1975.5, inicio: 0.30, dur: 0.075 },
        { f: 2093.0, inicio: 0.375, dur: 0.48 }
      ];
      sequencia.forEach(nota => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = nota.f;
        gain.gain.setValueAtTime(0.14, ctx.currentTime + nota.inicio);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + nota.inicio + nota.dur);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + nota.inicio);
        osc.stop(ctx.currentTime + nota.inicio + nota.dur);
      });
    } catch (e) {}
  }

  function atualizarTelaUrna() {
    caixas.forEach((caixa, idx) => {
      caixa.textContent = digitosAtuais[idx] || '';
      caixa.classList.toggle('ativo', idx === digitosAtuais.length && digitosAtuais.length < caixas.length);
    });

    document.querySelectorAll('.linha-candidato').forEach(tr => {
      tr.classList.toggle('ativa', tr.dataset.numero === digitosAtuais);
    });

    if (!digitosAtuais) {
      candidatoSelecionado = null;
      telaNome.textContent = '';
      telaPartido.textContent = '';
      telaStatus.textContent = '';
      telaStatus.className = 'lcd-status-msg';
      telaAvatarTag.textContent = 'Deputado Federal';
      telaFotoImg.style.display = 'none';
      telaSilhuetaSvg.style.display = 'block';
      return;
    }

    const numeroInt = Number(digitosAtuais);
    const encontrado = listaCandidatos.find(c => Number(c.numero) === numeroInt);

    if (encontrado) {
      candidatoSelecionado = encontrado;
      telaNome.textContent = encontrado.nome.toUpperCase();
      telaPartido.textContent = encontrado.partido;
      telaStatus.textContent = '';
      telaStatus.className = 'lcd-status-msg';
      telaAvatarTag.textContent = 'Deputado Federal';
      telaFotoImg.src = encontrado.foto;
      telaFotoImg.style.display = 'block';
      telaSilhuetaSvg.style.display = 'none';
    } else {
      candidatoSelecionado = null;
      telaNome.textContent = digitosAtuais.length >= 2 ? 'NÚMERO ERRADO' : '';
      telaPartido.textContent = digitosAtuais.length >= 2 ? 'VOTO NULO' : '';
      telaStatus.textContent = '';
      telaStatus.className = 'lcd-status-msg status-erro';
      telaAvatarTag.textContent = 'Deputado Federal';
      telaFotoImg.style.display = 'none';
      telaSilhuetaSvg.style.display = 'block';
    }
  }

  function inserirDigito(digito) {
    if (votando) return;
    if (digitosAtuais.length < caixas.length) {
      digitosAtuais += String(digito);
      tocarBipTecla(940, 0.055);
      atualizarTelaUrna();
    }
  }

  function acaoCorrige() {
    if (votando) return;
    digitosAtuais = '';
    tocarBipTecla(500, 0.075);
    atualizarTelaUrna();
  }

  function acaoBranco() {
    if (votando) return;
    if (listaCandidatos.length > 0) {
      digitosAtuais = String(listaCandidatos[0].numero);
      tocarBipTecla(720, 0.07);
      atualizarTelaUrna();
    }
  }

  function acaoConfirma() {
    if (votando) return;
    if (!candidatoSelecionado) {
      tocarBipTecla(260, 0.18);
      telaStatus.textContent = 'NÚMERO INEXISTENTE — CORRIJA SEU VOTO';
      telaStatus.className = 'lcd-status-msg status-erro';
      return;
    }

    votando = true;
    inputCandidatoId.value = candidatoSelecionado.id;
    lcdConteudoVoto.style.display = 'none';
    lcdConteudoFim.style.display = 'flex';

    setTimeout(() => { fimBarra.style.width = '100%'; }, 30);
    setTimeout(() => { tocarPirililimUrna(); }, 220);
    setTimeout(() => { formUrnaVoto.submit(); }, 1050);
  }

  document.querySelectorAll('.tecla-num').forEach(botao => {
    botao.addEventListener('click', () => inserirDigito(botao.dataset.num));
  });

  document.getElementById('btnCorrige').addEventListener('click', acaoCorrige);
  document.getElementById('btnBranco').addEventListener('click', acaoBranco);
  document.getElementById('btnConfirma').addEventListener('click', acaoConfirma);

  window.addEventListener('keydown', (ev) => {
    if (ev.target && ['INPUT', 'SELECT', 'TEXTAREA'].includes(ev.target.tagName)) return;
    if (ev.key >= '0' && ev.key <= '9') {
      inserirDigito(ev.key);
    } else if (ev.key === 'Backspace' || ev.key === 'Delete') {
      acaoCorrige();
    } else if (ev.key === 'Enter') {
      ev.preventDefault();
      acaoConfirma();
    }
  });

  window.preencherNaUrna = function(numero) {
    if (votando) return;
    digitosAtuais = String(numero);
    tocarBipTecla(980, 0.06);
    atualizarTelaUrna();
  };

  if (listaCandidatos.length > 0) {
    digitosAtuais = String(listaCandidatos[0].numero);
  }
  atualizarTelaUrna();
</script>

<%- include('partials/footer') %>
