<%- include('partials/header', { titulo: 'Candidatos' }) %>

<!-- Barra Superior: Cola Eleitoral + Alternador de Visor (Branco / Preto) -->
<div class="barra-controles-urna">
  <div class="cola-eleitoral">
    <span class="cola-label">Cola Eleitoral (Números):</span>
    <div class="cola-pilulas">
      <% if (candidatos.length === 0) { %>
        <span class="cola-vazia">Nenhum candidato cadastrado</span>
      <% } else { %>
        <% candidatos.forEach(candidato => { %>
          <button type="button" class="cola-pilula" onclick="preencherNaUrna('<%= candidato.numero %>')">
            <strong><%= candidato.numero %></strong>
            <span><%= candidato.nome %></span>
          </button>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="seletor-visor" role="group" aria-label="Cor do visor da urna">
    <span class="seletor-visor-label">Visor LCD:</span>
    <button type="button" class="btn-visor ativo" id="btnVisorBranco" onclick="definirModoVisor('branco')">
      <span class="bolinha-visor bolinha-clara"></span> Branco (Oficial)
    </button>
    <button type="button" class="btn-visor" id="btnVisorPreto" onclick="definirModoVisor('preto')">
      <span class="bolinha-visor bolinha-escura"></span> Preto (Noturno)
    </button>
  </div>
</div>

<!-- CHASSI BIPARTIDO DA URNA ELETRÔNICA (Lado Esquerdo: Visor LCD | Lado Direito: Teclado Tátil) -->
<section class="palco-urna">
  <div class="urna-chassi">
    <!-- BLOCO ESQUERDO: Visor LCD Rebaixado + Relevo da República -->
    <div class="urna-bloco-visor">
      <div class="visor-moldura-rebaixada">
        <div class="visor-lcd visor-branco" id="urnaTela">
          <!-- Estado 1: Tela de Votação -->
          <div class="lcd-tela-votacao" id="lcdConteudoVoto">
            <div class="lcd-corpo-superior">
              <!-- Coluna Esquerda do LCD -->
              <div class="lcd-info-esquerda">
                <div class="lcd-seu-voto">SEU VOTO PARA</div>
                <div class="lcd-cargo">DEPUTADO FEDERAL</div>

                <div class="lcd-linha-numero">
                  <span class="lcd-rotulo-num">Número:</span>
                  <div class="lcd-caixas-digitos" id="caixasNumero">
                    <span class="lcd-digito ativo" id="digito0"></span>
                    <span class="lcd-digito" id="digito1"></span>
                    <span class="lcd-digito" id="digito2"></span>
                    <span class="lcd-digito" id="digito3"></span>
                  </div>
                </div>

                <div class="lcd-dados-candidato">
                  <div class="lcd-campo">
                    <span class="lcd-rotulo">Nome:</span>
                    <span class="lcd-valor-nome" id="telaNome">—</span>
                  </div>
                  <div class="lcd-campo">
                    <span class="lcd-rotulo">Partido:</span>
                    <span class="lcd-valor-partido" id="telaPartido">—</span>
                  </div>
                  <div class="lcd-mensagem-status" id="telaStatus">
                    Digite o número no teclado ou clique em um candidato abaixo.
                  </div>
                </div>
              </div>

              <!-- Coluna Direita do LCD: Moldura 3:4 do Candidato + Espaço Suplente -->
              <div class="lcd-coluna-retrato">
                <div class="lcd-foto-3x4" id="telaAvatarBox">
                  <svg viewBox="0 0 120 160" class="lcd-silhueta-svg" aria-hidden="true">
                    <circle cx="60" cy="50" r="24" fill="currentColor"/>
                    <path d="M16 156 C16 106, 104 106, 104 156 Z" fill="currentColor"/>
                  </svg>
                  <div class="lcd-foto-legenda" id="telaAvatarTag">Deputado Federal</div>
                </div>
                <div class="lcd-suplente-box" id="telaSuplenteBox">
                  <span>Situação: <strong id="telaSituacao">Aguardando</strong></span>
                </div>
              </div>
            </div>

            <!-- Rodapé do LCD Separado por Linha Preta Sólida -->
            <div class="lcd-rodape-instrucoes">
              <div class="instrucao-cabecalho">Aperte a tecla:</div>
              <div class="instrucao-linha"><strong>VERDE</strong> para CONFIRMAR este voto</div>
              <div class="instrucao-linha"><strong>LARANJA</strong> para REINICIAR este voto</div>
            </div>
          </div>

          <!-- Estado 2: Tela Clássica de FIM + Gravando -->
          <div class="lcd-tela-fim" id="lcdConteudoFim" style="display: none;">
            <div class="fim-gravando-wrap" id="fimGravandoWrap">
              <span class="fim-gravando-label">GRAVANDO</span>
              <div class="fim-barra-borda">
                <div class="fim-barra-preenchimento" id="fimBarra"></div>
              </div>
            </div>
            <div class="fim-palavra" id="fimPalavra">FIM</div>
            <div class="fim-votou">VOTOU</div>
          </div>
        </div>
      </div>

      <!-- Detalhe Sutil em Relevo (Emboss) Abaixo do Visor -->
      <div class="urna-emboss-inferior" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="22" height="22" class="emboss-icone">
          <circle cx="32" cy="32" r="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="4 2"/>
          <polygon points="32,8 38,24 54,24 41,33 46,49 32,39 18,49 23,33 10,24 26,24" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="32" cy="32" r="8" fill="none" stroke="currentColor" stroke-width="2.5"/>
        </svg>
        <span>REPÚBLICA FEDERATIVA DO BRASIL • SISTEMA ELEITORAL MVC</span>
      </div>
    </div>

    <!-- BLOCO DIREITO: Placa da Justiça Eleitoral + Teclado Mecânico Tátil -->
    <div class="urna-bloco-teclado">
      <!-- Placa Institucional com Brasão da República -->
      <div class="placa-justica-eleitoral">
        <div class="placa-brasao" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="38" height="38">
            <circle cx="32" cy="32" r="28" fill="none" stroke="#3c4043" stroke-width="2" stroke-dasharray="3 2"/>
            <polygon points="32,7 39,23 56,23 42,33 47,50 32,40 17,50 22,33 8,23 25,23" fill="none" stroke="#2c3033" stroke-width="2.4"/>
            <circle cx="32" cy="32" r="10" fill="none" stroke="#2c3033" stroke-width="2.2"/>
            <path d="M22 31 Q32 27 42 31" fill="none" stroke="#2c3033" stroke-width="1.8"/>
          </svg>
        </div>
        <div class="placa-textos">
          <strong>JUSTIÇA</strong>
          <strong>ELEITORAL</strong>
        </div>
      </div>

      <!-- Berço Escuro Rebaixado do Teclado Mecânico -->
      <div class="teclado-berco">
        <div class="teclado-matriz-numerica">
          <% [
            { n: 1, b: '⠁' }, { n: 2, b: '⠃' }, { n: 3, b: '⠉' },
            { n: 4, b: '⠙' }, { n: 5, b: '⠑', central: true }, { n: 6, b: '⠋' },
            { n: 7, b: '⠛' }, { n: 8, b: '⠓' }, { n: 9, b: '⠊' }
          ].forEach(item => { %>
            <button type="button" class="tecla" data-num="<%= item.n %>" title="Tecla <%= item.n %>">
              <span class="tecla-num-txt"><%= item.n %></span>
              <% if (item.central) { %>
                <span class="tecla-5-circulo" title="Marcação tátil central da tecla 5"></span>
              <% } %>
              <span class="tecla-braille-txt"><%= item.b %></span>
            </button>
          <% }) %>
          <div class="tecla-slot-vazio"></div>
          <button type="button" class="tecla" data-num="0" title="Tecla 0">
            <span class="tecla-num-txt">0</span>
            <span class="tecla-braille-txt">⠚</span>
          </button>
          <div class="tecla-slot-vazio"></div>
        </div>

        <!-- Linha Inferior de Teclas de Função (BRANCO / CORRIGE / CONFIRMA mais alta) -->
        <div class="teclado-linha-funcoes">
          <button type="button" class="tecla-func tecla-branco" id="btnBranco" title="Votar em Branco">
            BRANCO
          </button>
          <button type="button" class="tecla-func tecla-corrige" id="btnCorrige" title="Corrigir voto">
            CORRIGE
          </button>
          <button type="button" class="tecla-func tecla-confirma" id="btnConfirma" title="Confirmar voto">
            CONFIRMA
          </button>
        </div>
      </div>
    </div>

    <form id="formUrnaVoto" action="/votos" method="POST" style="display:none;">
      <input type="hidden" name="candidatoId" id="inputCandidatoId" value="">
    </form>
  </div>
</section>

<!-- SEÇÃO MVC: TODOS OS CANDIDATOS CADASTRADOS (Preservando tudo que foi feito) -->
<section class="secao-dados">
  <div class="cabecalho-secao">
    <div>
      <p class="etiqueta">PADRÃO MVC • CAMADA DE VISUALIZAÇÃO (EJS)</p>
      <h1>Todos os candidatos</h1>
      <p class="subtitulo-secao">Lista de candidatos cadastrados no Model <code>Candidato</code> e processados pelo <code>CandidatoController</code>.</p>
    </div>
    <div class="resumo-contador">
      <span>Candidatos registrados</span>
      <strong><%= candidatos.length %></strong>
    </div>
  </div>

  <% if (candidatos.length === 0) { %>
    <div class="vazio">Nenhum candidato cadastrado.</div>
  <% } else { %>
    <div class="grade">
      <% candidatos.forEach(candidato => { %>
        <article class="cartao" data-numero="<%= candidato.numero %>" data-id="<%= candidato.id %>">
          <div class="cartao-topo">
            <span class="numero">Nº <%= candidato.numero %></span>
            <span class="placar"><%= candidato.totalVotos || 0 %> <%= (candidato.totalVotos === 1) ? 'voto' : 'votos' %></span>
          </div>
          <div class="cartao-corpo">
            <div class="cartao-mini-avatar" aria-hidden="true">
              <svg viewBox="0 0 64 64" width="38" height="38">
                <circle cx="32" cy="22" r="12" fill="#8b9bb4"/>
                <path d="M10 58 C10 40, 54 40, 54 58 Z" fill="#8b9bb4"/>
              </svg>
            </div>
            <div>
              <h2><%= candidato.nome %></h2>
              <p><%= candidato.partido %></p>
            </div>
          </div>
          <div class="cartao-rodape">
            <small>ID: <%= candidato.id %></small>
            <div class="cartao-botoes">
              <button type="button" class="botao-testar-urna" onclick="preencherNaUrna('<%= candidato.numero %>')">
                Digitar <%= candidato.numero %> na Urna
              </button>
              <form action="/votos" method="POST">
                <input type="hidden" name="candidatoId" value="<%= candidato.id %>">
                <button type="submit" class="botao-votar">Voto Direto</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>

  <p class="dica">
    Para cadastrar, alterar ou excluir candidatos via API REST (JSON), utilize os endpoints descritos no README ou no arquivo <code>client.http</code>.
  </p>
</section>

<script id="dadosCandidatosJson" type="application/json"><%- JSON.stringify(candidatos) %></script>
<script>
  const listaCandidatos = JSON.parse(document.getElementById('dadosCandidatosJson').textContent || '[]');
  let digitosAtuais = '';
  let candidatoSelecionado = null;
  let votando = false;

  const urnaTela = document.getElementById('urnaTela');
  const btnVisorBranco = document.getElementById('btnVisorBranco');
  const btnVisorPreto = document.getElementById('btnVisorPreto');

  const caixas = [
    document.getElementById('digito0'),
    document.getElementById('digito1'),
    document.getElementById('digito2'),
    document.getElementById('digito3')
  ];
  const telaNome = document.getElementById('telaNome');
  const telaPartido = document.getElementById('telaPartido');
  const telaStatus = document.getElementById('telaStatus');
  const telaAvatarTag = document.getElementById('telaAvatarTag');
  const telaSituacao = document.getElementById('telaSituacao');
  const inputCandidatoId = document.getElementById('inputCandidatoId');
  const formUrnaVoto = document.getElementById('formUrnaVoto');
  const lcdConteudoVoto = document.getElementById('lcdConteudoVoto');
  const lcdConteudoFim = document.getElementById('lcdConteudoFim');
  const fimBarra = document.getElementById('fimBarra');

  // Alternância de Visor Branco (Clássico LCD) / Visor Preto (Alto Contraste)
  window.definirModoVisor = function(modo) {
    if (modo === 'preto') {
      urnaTela.classList.remove('visor-branco');
      urnaTela.classList.add('visor-preto');
      btnVisorPreto.classList.add('ativo');
      btnVisorBranco.classList.remove('ativo');
    } else {
      urnaTela.classList.remove('visor-preto');
      urnaTela.classList.add('visor-branco');
      btnVisorBranco.classList.add('ativo');
      btnVisorPreto.classList.remove('ativo');
    }
    try { localStorage.setItem('urnaModoVisor', modo); } catch (e) {}
  };

  try {
    const modoSalvo = localStorage.getItem('urnaModoVisor');
    if (modoSalvo === 'preto') window.definirModoVisor('preto');
  } catch (e) {}

  // Bip de tecla
  function tocarBipTecla(frequencia = 920, duracao = 0.055) {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = frequencia;
      gain.gain.value = 0.08;
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duracao);
    } catch (e) {}
  }

  // Áudio polifônico clássico de confirmação da Urna (pirililim)
  function tocarPirililimUrna() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const sequencia = [
        { f: 1975.5, inicio: 0.00, dur: 0.075 },
        { f: 2093.0, inicio: 0.075, dur: 0.075 },
        { f: 1975.5, inicio: 0.15, dur: 0.075 },
        { f: 2093.0, inicio: 0.225, dur: 0.075 },
        { f: 1975.5, inicio: 0.30, dur: 0.075 },
        { f: 2093.0, inicio: 0.375, dur: 0.48 }
      ];
      sequencia.forEach(nota => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = nota.f;
        gain.gain.setValueAtTime(0.14, ctx.currentTime + nota.inicio);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + nota.inicio + nota.dur);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + nota.inicio);
        osc.stop(ctx.currentTime + nota.inicio + nota.dur);
      });
    } catch (e) {}
  }

  function atualizarTelaUrna() {
    caixas.forEach((caixa, idx) => {
      caixa.textContent = digitosAtuais[idx] || '';
      caixa.classList.toggle('ativo', idx === digitosAtuais.length && digitosAtuais.length < 4);
    });

    if (!digitosAtuais) {
      candidatoSelecionado = null;
      telaNome.textContent = '—';
      telaPartido.textContent = '—';
      telaStatus.textContent = 'Digite o número (' + listaCandidatos.map(c => c.numero).join(', ') + ') ou selecione na lista.';
      telaStatus.className = 'lcd-mensagem-status';
      telaAvatarTag.textContent = 'Deputado Federal';
      telaSituacao.textContent = 'Aguardando';
      return;
    }

    const numeroInt = Number(digitosAtuais);
    const encontrado = listaCandidatos.find(c => Number(c.numero) === numeroInt);

    if (encontrado) {
      candidatoSelecionado = encontrado;
      telaNome.textContent = encontrado.nome;
      telaPartido.textContent = encontrado.partido;
      telaStatus.textContent = '✔ Candidato válido — Aperte a tecla VERDE (CONFIRMA).';
      telaStatus.className = 'lcd-mensagem-status status-valido';
      telaAvatarTag.textContent = 'Nº ' + encontrado.numero;
      telaSituacao.textContent = 'Apto';
    } else {
      candidatoSelecionado = null;
      telaNome.textContent = digitosAtuais.length >= 2 ? 'NÚMERO ERRADO' : 'Digitando...';
      telaPartido.textContent = digitosAtuais.length >= 2 ? 'VOTO NULO' : '—';
      telaStatus.textContent = digitosAtuais.length >= 2
        ? 'Números existentes: ' + listaCandidatos.map(c => c.numero).join(', ')
        : 'Complete os dígitos do candidato...';
      telaStatus.className = 'lcd-mensagem-status status-alerta';
      telaAvatarTag.textContent = digitosAtuais.length >= 2 ? 'Voto Nulo' : '...';
      telaSituacao.textContent = digitosAtuais.length >= 2 ? 'Inexistente' : 'Digitando';
    }
  }

  function inserirDigito(digito) {
    if (votando) return;
    if (digitosAtuais.length < 4) {
      digitosAtuais += String(digito);
      tocarBipTecla(940, 0.055);
      atualizarTelaUrna();
    }
  }

  function acaoCorrige() {
    if (votando) return;
    digitosAtuais = '';
    tocarBipTecla(500, 0.075);
    atualizarTelaUrna();
  }

  function acaoBranco() {
    if (votando) return;
    if (listaCandidatos.length > 0) {
      digitosAtuais = String(listaCandidatos[0].numero);
      tocarBipTecla(720, 0.07);
      atualizarTelaUrna();
      telaStatus.textContent = 'Voto preenchido para ' + listaCandidatos[0].nome + '. Aperte CONFIRMA.';
      telaStatus.className = 'lcd-mensagem-status status-valido';
    }
  }

  function acaoConfirma() {
    if (votando) return;
    if (!candidatoSelecionado) {
      tocarBipTecla(260, 0.18);
      telaStatus.textContent = '⚠ Informe um número de candidato válido (' + listaCandidatos.map(c => c.numero).join(', ') + ') antes de confirmar.';
      telaStatus.className = 'lcd-mensagem-status status-alerta';
      return;
    }

    votando = true;
    inputCandidatoId.value = candidatoSelecionado.id;
    lcdConteudoVoto.style.display = 'none';
    lcdConteudoFim.style.display = 'flex';

    setTimeout(() => {
      fimBarra.style.width = '100%';
    }, 30);

    setTimeout(() => {
      tocarPirililimUrna();
    }, 220);

    setTimeout(() => {
      formUrnaVoto.submit();
    }, 1050);
  }

  document.querySelectorAll('.tecla').forEach(botao => {
    botao.addEventListener('click', () => inserirDigito(botao.dataset.num));
  });

  document.getElementById('btnCorrige').addEventListener('click', acaoCorrige);
  document.getElementById('btnBranco').addEventListener('click', acaoBranco);
  document.getElementById('btnConfirma').addEventListener('click', acaoConfirma);

  window.addEventListener('keydown', (ev) => {
    if (ev.target && ['INPUT', 'SELECT', 'TEXTAREA'].includes(ev.target.tagName)) return;
    if (ev.key >= '0' && ev.key <= '9') {
      inserirDigito(ev.key);
    } else if (ev.key === 'Backspace' || ev.key === 'Delete') {
      acaoCorrige();
    } else if (ev.key === 'Enter') {
      ev.preventDefault();
      acaoConfirma();
    }
  });

  window.preencherNaUrna = function(numero) {
    if (votando) return;
    digitosAtuais = String(numero);
    tocarBipTecla(980, 0.06);
    atualizarTelaUrna();
    document.querySelector('.palco-urna').scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  atualizarTelaUrna();
</script>

<%- include('partials/footer') %>
