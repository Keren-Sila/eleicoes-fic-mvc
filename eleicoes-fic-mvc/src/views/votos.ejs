<%- include('partials/header', { titulo: 'Votos' }) %>

<!-- Gabinete da Urna — Modo Boletim de Urna (Apuração Oficial) -->
<section class="palco-urna">
  <div class="urna-gabinete urna-gabinete-boletim">
    <div class="urna-chanfro-topo"></div>

    <div class="urna-painel-superior">
      <div class="urna-moldura-preta">
        <div class="urna-lcd">
          <div class="lcd-cabecalho">
            <div class="lcd-brasao" aria-hidden="true">
              <svg viewBox="0 0 64 64" width="38" height="38">
                <circle cx="32" cy="32" r="29" fill="#1e6b3a" stroke="#e8c14a" stroke-width="3"/>
                <polygon points="32,8 38,23 55,23 41,33 46,49 32,39 18,49 23,33 9,23 26,23" fill="#f0c84b" stroke="#b8860b" stroke-width="1"/>
                <circle cx="32" cy="32" r="9.5" fill="#1a4b8c" stroke="#ffffff" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="lcd-titulo-institucional">JUSTIÇA ELEITORAL — BOLETIM DE URNA</div>
          </div>

          <div class="lcd-faixa-azul">
            Apuração Oficial em Tempo Real — Total de votos computados: <%= votos.length %>
          </div>

          <% if (typeof candidatos !== 'undefined' && candidatos.length > 0) { %>
            <div class="boletim-grade">
              <% candidatos.forEach(candidato => {
                const qtd = candidato.totalVotos || 0;
                const perc = votos.length > 0 ? Math.round((qtd / votos.length) * 100) : 0;
              %>
                <div class="boletim-item">
                  <div class="boletim-linha-topo">
                    <span class="boletim-num">Nº <%= candidato.numero %></span>
                    <div class="boletim-info">
                      <strong><%= candidato.nome %></strong>
                      <small><%= candidato.partido %></small>
                    </div>
                    <div class="boletim-placar-direita">
                      <span class="boletim-votos"><%= qtd %> <%= qtd === 1 ? 'voto' : 'votos' %></span>
                      <span class="boletim-perc"><%= perc %>%</span>
                    </div>
                  </div>
                  <div class="boletim-barra-fundo">
                    <div class="boletim-barra-preenchimento" style="width: <%= perc %>%;"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="lcd-rodape-instrucoes">
            <div>Para digitar no teclado físico da Urna Eletrônica, acesse <a href="/candidatos" class="link-urna">Urna &amp; Candidatos</a>.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Seção MVC: Formulário e Tabela de Registro Geral de Votos -->
<section class="secao-dados">
  <div class="cabecalho-secao">
    <div>
      <p class="etiqueta">PADRÃO MVC • HISTÓRICO DE AUDITORIA</p>
      <h1>Todos os votos registrados</h1>
      <p class="subtitulo-secao">Registros de votos processados pelo <code>VotoController</code> nesta execução do servidor.</p>
    </div>
    <div class="resumo-contador">
      <span>Total de votos</span>
      <strong><%= votos.length %></strong>
    </div>
  </div>

  <% if (typeof candidatos !== 'undefined' && candidatos.length > 0) { %>
    <section class="painel-voto">
      <form class="form-voto" action="/votos" method="POST">
        <label for="candidatoId">Registrar voto direto:</label>
        <select id="candidatoId" name="candidatoId" required>
          <% candidatos.forEach(candidato => { %>
            <option value="<%= candidato.id %>">Nº <%= candidato.numero %> — <%= candidato.nome %> (<%= candidato.partido %>)</option>
          <% }) %>
        </select>
        <button type="submit" class="botao-votar">CONFIRMAR VOTO</button>
      </form>
    </section>
  <% } %>

  <% if (votos.length === 0) { %>
    <div class="vazio">
      Ainda não há votos registrados.<br>
      <span>Você pode votar usando a <a href="/candidatos">Urna Eletrônica Interativa</a>, o seletor acima ou enviando <code>POST /api/votos</code>.</span>
    </div>
  <% } else { %>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>ID do voto</th>
            <th>Candidato</th>
            <th>Número</th>
            <th>Partido</th>
            <th>ID do candidato</th>
            <th>Data e hora</th>
          </tr>
        </thead>
        <tbody>
          <% votos.forEach(voto => { %>
            <tr>
              <td><span class="tag-id">#<%= voto.id %></span></td>
              <td><strong><%= voto.candidatoNome %></strong></td>
              <td><span class="tag-num">Nº <%= voto.candidatoNumero %></span></td>
              <td><%= voto.candidatoPartido %></td>
              <td><%= voto.candidatoId %></td>
              <td><%= voto.dataFormatada %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
