<%- include('partials/header', { titulo: 'Votos' }) %>

<!-- Barra Superior: Alternador de Visor (Branco / Preto) -->
<div class="barra-controles-urna">
  <div class="cola-eleitoral">
    <span class="cola-label">Apuração Oficial:</span>
    <span style="font-size: 0.84rem; color: #cbd5e1;">Total de <strong><%= votos.length %></strong> <%= votos.length === 1 ? 'voto registrado' : 'votos registrados' %></span>
  </div>

  <div class="seletor-visor" role="group" aria-label="Cor do visor da urna">
    <span class="seletor-visor-label">Visor LCD:</span>
    <button type="button" class="btn-visor ativo" id="btnVisorBranco" onclick="definirModoVisor('branco')">
      <span class="bolinha-visor bolinha-clara"></span> Branco (Oficial)
    </button>
    <button type="button" class="btn-visor" id="btnVisorPreto" onclick="definirModoVisor('preto')">
      <span class="bolinha-visor bolinha-escura"></span> Preto (Noturno)
    </button>
  </div>
</div>

<!-- Chassi da Urna — Modo Boletim de Urna -->
<section class="palco-urna">
  <div class="urna-chassi urna-chassi-boletim">
    <div class="urna-bloco-visor">
      <div class="visor-moldura-rebaixada">
        <div class="visor-lcd visor-branco" id="urnaTela">
          <div class="lcd-seu-voto">JUSTIÇA ELEITORAL • BOLETIM DE URNA</div>
          <div class="lcd-cargo" style="margin-bottom: 14px;">TOTALIZAÇÃO — DEPUTADO FEDERAL</div>

          <% if (typeof candidatos !== 'undefined' && candidatos.length > 0) { %>
            <div class="boletim-grade">
              <% candidatos.forEach(candidato => {
                const qtd = candidato.totalVotos || 0;
                const perc = votos.length > 0 ? Math.round((qtd / votos.length) * 100) : 0;
              %>
                <div class="boletim-item">
                  <div class="boletim-linha-topo">
                    <span class="boletim-num">Nº <%= candidato.numero %></span>
                    <div class="boletim-info">
                      <strong><%= candidato.nome %></strong>
                      <small><%= candidato.partido %></small>
                    </div>
                    <div class="boletim-placar-direita">
                      <span class="boletim-votos"><%= qtd %> <%= qtd === 1 ? 'voto' : 'votos' %></span>
                      <span class="boletim-perc"><%= perc %>%</span>
                    </div>
                  </div>
                  <div class="boletim-barra-fundo">
                    <div class="boletim-barra-preenchimento" style="width: <%= perc %>%;"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="lcd-rodape-instrucoes" style="margin-top: 16px;">
            <div class="instrucao-cabecalho">Instrução:</div>
            <div class="instrucao-linha">Para digitar no teclado tátil da Urna Eletrônica, acesse <a href="/candidatos" class="link-urna">Urna &amp; Candidatos</a>.</div>
          </div>
        </div>
      </div>

      <div class="urna-emboss-inferior" aria-hidden="true">
        <span>REPÚBLICA FEDERATIVA DO BRASIL • BOLETIM DE APURAÇÃO EM MEMÓRIA</span>
      </div>
    </div>
  </div>
</section>

<!-- Seção MVC: Formulário e Tabela de Todos os Votos -->
<section class="secao-dados">
  <div class="cabecalho-secao">
    <div>
      <p class="etiqueta">PADRÃO MVC • HISTÓRICO DE AUDITORIA</p>
      <h1>Todos os votos</h1>
      <p class="subtitulo-secao">Registros de votos feitos nesta execução do servidor (Total: <strong><%= votos.length %></strong>).</p>
    </div>
    <div class="resumo-contador">
      <span>Votos computados</span>
      <strong><%= votos.length %></strong>
    </div>
  </div>

  <% if (typeof candidatos !== 'undefined' && candidatos.length > 0) { %>
    <section class="painel-voto">
      <form class="form-voto" action="/votos" method="POST">
        <label for="candidatoId">Registrar voto rápido:</label>
        <select id="candidatoId" name="candidatoId" required>
          <% candidatos.forEach(candidato => { %>
            <option value="<%= candidato.id %>">Nº <%= candidato.numero %> — <%= candidato.nome %> (<%= candidato.partido %>)</option>
          <% }) %>
        </select>
        <button type="submit" class="botao-votar">CONFIRMAR VOTO</button>
      </form>
    </section>
  <% } %>

  <% if (votos.length === 0) { %>
    <div class="vazio">
      Ainda não há votos registrados.<br>
      <span>Você pode votar pela <a href="/candidatos">Urna Eletrônica</a>, pelo formulário acima ou usando <code>POST /api/votos</code>.</span>
    </div>
  <% } else { %>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>ID do voto</th>
            <th>Candidato</th>
            <th>Número</th>
            <th>Partido</th>
            <th>ID do candidato</th>
            <th>Data e hora</th>
          </tr>
        </thead>
        <tbody>
          <% votos.forEach(voto => { %>
            <tr>
              <td><span class="tag-id">#<%= voto.id %></span></td>
              <td><strong><%= voto.candidatoNome %></strong></td>
              <td><span class="tag-num">Nº <%= voto.candidatoNumero %></span></td>
              <td><%= voto.candidatoPartido %></td>
              <td><%= voto.candidatoId %></td>
              <td><%= voto.dataFormatada %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<script>
  const urnaTela = document.getElementById('urnaTela');
  const btnVisorBranco = document.getElementById('btnVisorBranco');
  const btnVisorPreto = document.getElementById('btnVisorPreto');

  window.definirModoVisor = function(modo) {
    if (modo === 'preto') {
      urnaTela.classList.remove('visor-branco');
      urnaTela.classList.add('visor-preto');
      btnVisorPreto.classList.add('ativo');
      btnVisorBranco.classList.remove('ativo');
    } else {
      urnaTela.classList.remove('visor-preto');
      urnaTela.classList.add('visor-branco');
      btnVisorBranco.classList.add('ativo');
      btnVisorPreto.classList.remove('ativo');
    }
    try { localStorage.setItem('urnaModoVisor', modo); } catch (e) {}
  };

  try {
    const modoSalvo = localStorage.getItem('urnaModoVisor');
    if (modoSalvo === 'preto') window.definirModoVisor('preto');
  } catch (e) {}
</script>

<%- include('partials/footer') %>
